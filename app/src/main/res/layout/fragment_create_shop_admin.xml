<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CreateShopAdminFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp"
        >

        <TextView
            android:id="@+id/tv_shop_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:text="TextView"
            android:textSize="18dp"
            android:layout_margin="8dp"
            android:background="@drawable/boarder"/>

        <TextView
            android:id="@+id/tv_role"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:text="Role: Administrator"
            android:textSize="18dp"
            android:layout_margin="8dp"
            android:background="@drawable/boarder"/>

        <EditText
            android:id="@+id/et_first_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:background="@drawable/boarder"
            android:ems="20"
            android:hint="First Name"
            android:inputType="text"
            android:padding="5dp" />

        <EditText
            android:id="@+id/et_other_names"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:hint="Other Names"
            android:padding="5dp"
            android:layout_margin="8dp"
            android:background="@drawable/boarder"/>

        <EditText
            android:id="@+id/et_admin_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="phone"
            android:padding="5dp"
            android:layout_margin="8dp"
            android:hint="Phone"
            android:background="@drawable/boarder"/>

        <EditText
            android:id="@+id/et_admin_pass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="textPassword"
            android:padding="5dp"
            android:layout_margin="8dp"
            android:hint="password"
            android:background="@drawable/boarder"/>

        <EditText
            android:id="@+id/et_confirm_admin_pass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="textPassword"
            android:padding="5dp"
            android:layout_margin="8dp"
            android:hint="confirm password"
            android:background="@drawable/boarder"/>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btn_create_admin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ok"
            android:padding="5dp"
            android:layout_margin="8dp"
            android:background="@drawable/boarder"/>
    </LinearLayout>
</FrameLayout>