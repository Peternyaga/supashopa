<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ShopsActivity"
    >

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/shopsappbar"
        android:layout_width="match_parent"
        android:layout_height="47dp"
        android:layout_alignParentTop="true"
        android:background="@color/colorPrimaryDark"
        app:titleTextAppearance="@style/Base.CardView"
        >

        <androidx.appcompat.widget.SearchView
            android:id="@+id/search_shops"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            app:iconifiedByDefault="false"
            android:layout_marginStart="2dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/round_button"
            android:foregroundGravity="center"
            android:gravity="bottom"
            android:theme="@style/SearchViewStyle"
            android:translationZ="2dp"
            app:commitIcon="@drawable/ic_search"
            app:queryHint="search for a shop"
            app:defaultQueryHint="search for a shop"
            />

    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:id="@+id/networkerror"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:visibility="gone">
    <TextView
        android:id="@+id/tv_networkerror"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/network_error"
        android:textStyle="bold"
        android:gravity="center"
        app:drawableTopCompat="@drawable/ic_error_outline_black_24dp" />

        <TextView
            android:id="@+id/tvrefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/refresh"
            android:textStyle="bold"
            android:textColor="#2196F3"
            android:layout_marginTop="10dp"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_shops"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/shopsappbar"
        android:layout_marginTop="2dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />
</RelativeLayout>